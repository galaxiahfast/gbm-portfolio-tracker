.venv/
__pycache__/
.pytest_cache/
.pytest_*/
logs/
*.py[cod]

# Datos privados y persistentes: nunca deben entrar al historial de Git.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Credenciales y configuración local.
.env
.env.*
.streamlit/secrets.toml

# Archivos temporales, respaldos y empaquetados locales.
tmp/
backups/*
!backups/.gitkeep
!backups/portfolio.db.aesgcm
!backups/receipts.aesgcm
!backups/manifest.json
*.bak
*.zip

# La estructura SQL sí se versiona; jamás contiene registros del usuario.
database/*.db

